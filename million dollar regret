<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>The Million Dollar Regret</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            background: #111;
            color: #ff4444;
            font-family: 'Arial Black', sans-serif;
            text-align: center;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
        }
        .regret-button {
            width: 380px;
            height: 380px;
            border-radius: 50%;
            background: #220000;
            border: 25px solid #ff4444;
            color: #fff;
            font-size: 2.8em;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 0 80px #ff0000, inset 0 0 60px #440000;
            transition: all 0.1s;
            margin: 30px 0;
            user-select: none;
        }
        .regret-button:active { transform: scale(0.95); }
        h1 { font-size: 3.5em; margin: 20px 0 10px; text-shadow: 0 0 30px #ff0000; }
        .counter { font-size: 2.8em; margin: 10px 0; letter-spacing: 4px; }
        .wall, #leaderboard { max-width: 800px; width: 90%; margin: 30px auto; }
    </style>
</head>
<body>
    <h1>I REGRET BUYING THIS</h1>
    <div class="regret-button" id="big-button">CLICK TO REGRET</div>
    <div class="counter"><span id="regret-count">0</span> REGRETS</div>
    <p style="max-width: 600px; opacity: 0.8;">$1 per public admission of terrible decision-making</p>

    <div class="wall" id="wall-of-regret">
        <strong>WALL OF REGRET:</strong><br><br>
        <em>No regrets yet... be the first!</em>
    </div>

    <div style="margin-top: 40px; width: 90%; max-width: 800px;">
        <h2 style="color: #ffaa00;">🏆 REGRET HALL OF FAME 🏆</h2>
        <div id="leaderboard" style="background: #1a0000; padding: 20px; border: 4px solid #ffaa00; text-align: left; min-height: 100px;">
            <em>No legendary regretters yet...</em>
        </div>
    </div>

    <!-- Modal -->
    <div id="regret-modal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.95); z-index: 1000; align-items: center; justify-content: center;">
        <div style="background: #111; padding: 30px; border: 4px solid #ff4444; max-width: 500px; width: 90%;">
            <h2 style="color: #ffaa00; margin-top: 0;">Make Your Regret Official</h2>
            <p>$1.00 — One Public Regret</p>
            
            <input id="regret-name" type="text" placeholder="Your name / username" style="width: 100%; padding: 12px; margin: 10px 0; background: #222; border: 2px solid #ff4444; color: #fff; font-size: 1.1em;">
            <textarea id="regret-message" placeholder="Write your regret here..." style="width: 100%; height: 120px; padding: 12px; background: #222; border: 2px solid #ff4444; color: #fff; font-size: 1.1em;"></textarea>
            
            <div style="margin-top: 20px; text-align: center;">
                <button onclick="processPayment()" style="background:#ffaa00; color:#000; padding: 15px 50px; font-size: 1.4em; border:none; cursor:pointer; font-weight:bold;">PAY $1 WITH STRIPE</button>
                <button onclick="closeModal()" style="margin-left:15px; background:#444; color:#fff; padding:15px 30px; font-size:1em; border:none; cursor:pointer;">Cancel</button>
            </div>
        </div>
    </div>

    <script>
        let count = 0;
        const countEl = document.getElementById('regret-count');
        const button = document.getElementById('big-button');

        button.addEventListener('click', () => {
            document.getElementById('regret-modal').style.display = 'flex';
        });

        function closeModal() {
            document.getElementById('regret-modal').style.display = 'none';
        }

        function processPayment() {
            const name = document.getElementById('regret-name').value.trim() || "Anonymous";
            const message = document.getElementById('regret-message').value.trim() || "I regret this already";
            closeModal();

            alert("🔄 Processing $1 payment with Stripe... (Demo mode)");

            count++;
            countEl.textContent = count;

            // Add to wall
            const wall = document.getElementById('wall-of-regret');
            const entry = document.createElement('div');
            entry.innerHTML = `<strong>${name}</strong> — "${message}" <span style="opacity:0.6">- just now</span>`;
            if (wall.querySelector('em')) wall.innerHTML = ''; // remove "no regrets" text
            wall.appendChild(entry);
            wall.scrollTop = wall.scrollHeight;
        }
    </script>
</body>
</html>
